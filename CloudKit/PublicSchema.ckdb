        "___recordID"          REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT WRITE TO "_icloud",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Subscription (
        CD_billingPeriod       BYTES QUERYABLE SORTABLE,
        CD_category            BYTES QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_expiryDate          TIMESTAMP QUERYABLE SORTABLE,
        CD_includeInSummary    INT64 QUERYABLE SORTABLE,
        CD_loginEmail          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_loginEmail_ckAsset  ASSET,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_name                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset        ASSET,
        CD_notes               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes_ckAsset       ASSET,
        CD_password            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_password_ckAsset    ASSET,
        CD_priceAmount         DOUBLE QUERYABLE SORTABLE,
        CD_renewalDate         TIMESTAMP QUERYABLE SORTABLE,
        CD_sortOrder           INT64 QUERYABLE SORTABLE,
        CD_websiteURL          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_websiteURL_ckAsset  ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT WRITE TO "_icloud",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_VacationIdea (
        CD_coverImageData              BYTES QUERYABLE SORTABLE,
        CD_coverImageData_ckAsset      ASSET,
        CD_entityName                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_latitude                    DOUBLE QUERYABLE SORTABLE,
        CD_longitude                   DOUBLE QUERYABLE SORTABLE,
        CD_moveReceipt                 BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset         ASSET,
        CD_notes                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes_ckAsset               ASSET,
        CD_proposedDates               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_proposedDates_ckAsset       ASSET,
        CD_proposedDestination         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_proposedDestination_ckAsset ASSET,
        CD_upvotes                     INT64 QUERYABLE SORTABLE,
        CD_voterNamesJSON              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_voterNamesJSON_ckAsset      ASSET,
        "___createTime"                TIMESTAMP,
        "___createdBy"                 REFERENCE,
        "___etag"                      STRING,
        "___modTime"                   TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy"                REFERENCE,
        "___recordID"                  REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT WRITE TO "_icloud",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT WRITE TO "_icloud",
        GRANT READ TO "_world"
    );
