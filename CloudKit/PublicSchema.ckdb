DEFINE SCHEMA

    RECORD TYPE CD_Asset (
        CD_assetClass          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_assetClass_ckAsset  ASSET,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
