    "calendar.reminder_footer_birthday": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Birthday reminders fire at 8 AM the day before (“tomorrow”) and on the day (“today”). Optional offset applies before 8 AM on the birthday only. Allow notifications in Settings if you don’t see alerts."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bursdagsvarsler sendes kl. 08 dagen før («i morgen») og på dagen («i dag»). Valgfri offset gjelder kun samme dag før kl. 08. Tillat varsler i Innstillinger hvis du ikke ser dem."
          }
        }
      }
    },
