          "stringUnit": {
            "state": "translated",
            "value": "Add a stop and use Look up place (or enter latitude and longitude) to see pins and a path on this trip’s route map."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til et stopp og bruk stedssøk (eller skriv bredde- og lengdegrad) for å se nåler og rute på denne turens kart."
          }
        }
      }
    },
