    "map.empty.all_detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a trip pin to open that trip. Each trip uses the city you pick for the heading photo (Edit trip). Without that, we try your cover place name, main accommodation, or trip name. Stops only affect each trip’s route map. Ideas need a place or coordinates. Use All, Past, Upcoming, or Ideas above."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk en turnål for å åpne turen. Hver tur bruker byen du velger for toppbildet (Rediger tur). Uten det prøver vi omslagssted, hovedovernatting eller turnavn. Stopp påvirker bare rutekartet for turen. Ideer trenger sted eller koordinater. Bruk Alle, Tidligere, Kommende eller Ideer over."
          }
        }
      }
    },
