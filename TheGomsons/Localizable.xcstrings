    "sync.error.asset_fetch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud %@ failed: CloudKit could not download photo/file assets (often family photos on CD_FamilyPerson). Try again on Wi‑Fi or a real device; if the same records keep failing, clear those photos in CloudKit Console (Public → CD_FamilyPerson) or re-save the photos in the app."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud %@ feilet: CloudKit klarte ikke å laste ned bilde-/fil-assets (ofte familiebilder på CD_FamilyPerson). Prøv på Wi‑Fi eller en ekte enhet; hvis de samme postene feiler igjen, fjern bildene i CloudKit Console (Public → CD_FamilyPerson) eller lagre bildene på nytt i appen."
          }
        }
      }
    },
