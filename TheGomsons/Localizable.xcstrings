    "sync.hint.asset_fetch_short": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo or file asset download failed — try Wi‑Fi or re-save the photo in the app."
          }
        },
        "nb": {
