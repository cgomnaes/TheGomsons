    "map.empty.all_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a trip pin to open that trip. Each trip uses the city you pick for the heading photo (Edit trip). Without that, we try your cover place name, main accommodation, or trip name. Stops only affect each trip’s route map. Ideas need a place or coordinates. Use All, Past, Upcoming, or Ideas above."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk en turnål for å åpne turen. Hver tur bruker byen du velger for toppbildet (Rediger tur). Uten det prøver vi omslagssted, hovedovernatting eller turnavn. Stopp påvirker bare rutekartet for turen. Ideer trenger sted eller koordinater. Bruk Alle, Tidligere, Kommende eller Ideer over."
          }
        }
      }
    },
    "map.empty.past_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No past trips to show yet. Edit a trip, search under the heading photo, and pick a city—or we’ll try to place it from main accommodation or the trip name."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tidligere turer å vise ennå. Rediger en tur, søk under toppbildet og velg by — eller vi prøver å plassere den fra hovedovernatting eller turnavn."
          }
        }
      }
    },
    "map.empty.upcoming_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No upcoming trips to show yet. Set a cover city from Edit trip, or fill in main accommodation or the trip name so we can place the pin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kommende turer å vise ennå. Sett omslagsby i Rediger tur, eller fyll inn hovedovernatting eller turnavn så vi kan plassere nålen."
          }
        }
      }
    },
    "map.empty.ideas_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No vacation ideas with a map location yet. Add a proposal on the Ideas tab with a place search or coordinates."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen ferieideer med kartsted ennå. Legg til et forslag under Ideer med stedsøk eller koordinater."
          }
        }
      }
    },
    "map.trip.empty_title": {
      "localizations": {
