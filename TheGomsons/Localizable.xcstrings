    "sync.family": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family sync"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Familie-synk"
          }
        }
      }
    },
    "sync.family_footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app keeps one shared family library in iCloud (holidays, properties, stash, calendar, subs, family tree). Every signed-in device should show the same entries. If someone only sees what they typed on their own phone, CloudKit is not importing others’ data—check Xcode for CloudKit errors, fix indexes in CloudKit Console, use the same TestFlight/App Store build for everyone, and confirm public record types allow reads for all family accounts—not creator-only."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen har ett delt familiebibliotek i iCloud (ferier, eiendom, utstyr, kalender, abonnement, slektstre). Alle innloggede enheter skal vise samme data. Ser du bare egne notater, sjekk CloudKit-feil, indekser i CloudKit Console, samme TestFlight/App Store-build, og at alle familiemedlemmer kan lese offentlige poster."
          }
        }
      }
    },
    "sync.env_footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This install uses CloudKit’s Production database—the same pool as TestFlight and the App Store, including when you Run from Xcode. Everyone needs iCloud signed in and indexes configured in CloudKit Console (Production) if mirroring logs errors. Xcode changes to trips or properties are visible to testers; remove the Production container environment entitlement from the target if you need a separate Development database again."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne installasjonen bruker CloudKit Production (samme som TestFlight/App Store, også fra Xcode). Alle trenger iCloud og riktige indekser i CloudKit Console ved speilfeil. Endringer fra Xcode er synlige for testere; fjern Production-entitlement hvis du trenger egen utviklingsdatabase."
          }
        }
      }
    },
    "sync.error.generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud %@ failed: %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud %@ feilet: %@"
          }
        }
      }
    },
    "sync.error.schema_mismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud %@ failed: the Production CloudKit schema is missing fields (for example CD_propertyRegisterURL on properties). Import CloudKit/PublicSchema.ckdb to Development, then Deploy Schema to Production in CloudKit Console."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud %@ feilet: Production-skjemaet mangler felt (for eksempel CD_propertyRegisterURL på eiendommer). Importer CloudKit/PublicSchema.ckdb til Development, og deploy skjemaet til Production i CloudKit Console."
          }
        }
      }
    },
    "sync.error.indexes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud %@ failed: CloudKit indexes are missing (Queryable/Sortable on ___modTime or recordName). Add them in CloudKit Console for Production, then try again."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud %@ feilet: CloudKit-indekser mangler (Queryable/Sortable på ___modTime eller recordName). Legg dem til i CloudKit Console for Production, og prøv igjen."
          }
        }
      }
    },
    "sync.error.permission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud %@ failed: this iCloud account is not allowed to update a shared record. In CloudKit Console, grant Authenticated (_icloud) Write on CD_* types and deploy to Production."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud %@ feilet: denne iCloud-kontoen har ikke lov til å oppdatere en delt post. Gi Authenticated (_icloud) Write på CD_*-typene i CloudKit Console og deploy til Production."
          }
        }
      }
    },
    "sync.error.partial": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud %@ failed: some records could not sync (CloudKit error 2). %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud %@ feilet: noen poster kunne ikke synkes (CloudKit-feil 2). %@"
          }
        }
      }
    },
    "sync.error.partial_fallback": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import CloudKit/PublicSchema.ckdb to Development, then Deploy Schema to Production in CloudKit Console."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer CloudKit/PublicSchema.ckdb til Development, og deploy skjemaet til Production i CloudKit Console."
          }
        }
      }
