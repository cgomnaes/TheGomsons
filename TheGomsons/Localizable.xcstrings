          "stringUnit": {
            "state": "translated",
            "value": "No map pins yet"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kartnåler ennå"
          }
        }
      }
    },
    "map.trip.empty_detail": {
      "localizations": {
