    "trip.cover.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We search Wikipedia for photos of that place (real pictures). If none are found, we fall back to satellite map views. Or choose any photo from your library. Search and pick a city to place the trip on the holiday world map; stops on the trip screen are only for your route map."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi søker etter Wikipedia-bilder av stedet (ekte bilder). Hvis ingen finnes, bruker vi satellitt. Eller velg bilde fra biblioteket. Søk og velg by for ferieverdenskartet; stopp på turskjermen er bare for rutekart."
          }
        }
      }
    },
