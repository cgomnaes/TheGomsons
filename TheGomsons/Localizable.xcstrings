    "sync.env_footnote" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This install uses CloudKit’s Production database—the same pool as TestFlight and the App Store, including when you Run from Xcode. Everyone needs iCloud signed in and indexes configured in CloudKit Console (Production) if mirroring logs errors. Xcode changes to trips or properties are visible to testers; remove the Production container environment entitlement from the target if you need a separate Development database again."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne installasjonen bruker CloudKit Production (samme som TestFlight/App Store, også fra Xcode). Alle trenger iCloud og riktige indekser i CloudKit Console ved speilfeil. Endringer fra Xcode er synlige for testere; fjern Production-entitlement hvis du trenger egen utviklingsdatabase."
          }
        }
      }
    },
    "sync.family" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family sync"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familie-synk"
          }
        }
      }
    },
    "sync.family_footnote" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app keeps one shared family library in iCloud (holidays, properties, stash, calendar, subs, family tree). Every signed-in device should show the same entries. If someone only sees what they typed on their own phone, CloudKit is not importing others’ data—check Xcode for CloudKit errors, fix indexes in CloudKit Console, use the same TestFlight/App Store build for everyone, and confirm public record types allow reads for all family accounts—not creator-only."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen har ett delt familiebibliotek i iCloud (ferier, eiendom, utstyr, kalender, abonnement, slektstre). Alle innloggede enheter skal vise samme data. Ser du bare egne notater, sjekk CloudKit-feil, indekser i CloudKit Console, samme TestFlight/App Store-build, og at alle familiemedlemmer kan lese offentlige poster."
          }
        }
      }
    },
